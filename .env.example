# Env for the root scripts (seed:devnet, demo:orders). Copy to .env. Devnet only.
# See specs/01-arquitectura.md §7.

# vaultix_escrow on devnet (also in Anchor.toml and web/.env.example)
NEXT_PUBLIC_PROGRAM_ID=Fg215nqtnNCBuZY4obrSUVbueGHxpfViP5Mfw3DxZ6Bg
# Circle devnet USDC mint
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Defaults to https://api.devnet.solana.com. Mainnet URLs are rejected.
SOLANA_RPC=
# Defaults to ~/.config/solana/id.json (admin and treasury owner)
SOLANA_KEYPAIR=
# Team Phantom pubkey. Empty = the admin keypair acts as provisional arbiter.
ARBITER_PUBKEY=
